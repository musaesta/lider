# Локально: скопируйте URL и publishable key из `npx supabase status`.
# Обычно http://127.0.0.1:54321 и anon / publishable key.
# Облако не подключайте, пока не решите выкладывать магазин.
NEXT_PUBLIC_SUPABASE_URL=

# Только publishable / anon key. Никогда не кладите service_role в NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
